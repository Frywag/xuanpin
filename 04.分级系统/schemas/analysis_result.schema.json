{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "analysis_result.schema.json",
  "title": "AnalysisResult",
  "description": "L1/L2/L3 分层结果 + PScore + S/A/B/C + 证据绑定的 claims",
  "type": "object",
  "required": ["analysis_id", "candidate_id", "market", "layer_results",
               "priority_score", "recommendation", "claims", "schema_version"],
  "properties": {
    "schema_version": {"const": "analysis.result.v1"},
    "analysis_id": {"type": "string"},
    "candidate_id": {"type": "string"},
    "market": {"const": "US"},
    "layer_results": {
      "type": "object",
      "required": ["L1", "L2", "L3"],
      "additionalProperties": {
        "type": "object",
        "properties": {
          "passed": {"type": ["boolean", "null"]},
          "score": {"type": ["number", "null"]},
          "grade": {"enum": ["S", "A", "B", "C", null]},
          "gate_reason": {"type": ["string", "null"]},
          "required_next_data": {"type": "array"}
        }
      }
    },
    "priority_score": {
      "type": "object",
      "required": ["total", "achievable_max", "pct", "grade", "components"],
      "properties": {
        "grade": {"enum": ["S", "A", "B", "C", null]},
        "components": {"type": "array", "items": {
          "type": "object",
          "required": ["name", "score", "max_score", "reason", "evidence_refs"]}}
      }
    },
    "track_tags": {"type": "array", "items": {"type": "string"}},
    "recommendation": {
      "type": "object",
      "required": ["decision", "reason_summary", "risk_summary", "next_actions"],
      "properties": {"decision": {"enum": ["recommend_research", "research_more",
                                            "watchlist", "drop", "blocked", null]}}
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim", "claim_type", "evidence_refs", "confidence"],
        "properties": {
          "evidence_refs": {"type": "array", "minItems": 1,
                            "description": "每条 claim 必须绑定至少一条证据"}
        }
      }
    },
    "missing_fields": {"type": "array"},
    "blocked_reasons": {"type": "array"},
    "confidence": {"enum": ["high", "medium", "low"]},
    "created_at": {"type": ["string", "null"]}
  }
}
